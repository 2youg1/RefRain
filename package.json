{
  "name": "refrain",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/desktop && bun run dev",
    "check": "tsc --noEmit && bun run check:desktop && bun run check:svelte",
    "check:desktop": "cd apps/desktop && bun x tsc --noEmit -p tsconfig.json",
    "fmt": "biome check --write .",
    "fmt:check": "biome check .",
    "test": "bun test",
    "gate": "bun run fmt:check && bun run check && bun test",
    "verify:gate": "bun scripts/verify-gate.ts",
    "verify:no-network": "bun scripts/verify-no-network.ts",
    "verify:trash-only": "bun scripts/verify-trash-only.ts",
    "verify:gates-run": "bun scripts/verify-gates-run.ts",
    "native": "cd packages/fs && cargo build --release && bun run scripts/build.ts",
    "check:svelte": "cd apps/desktop && bun scripts/check-svelte.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "latest",
    "@types/node": "^26.1.1",
    "mermaid": "^11.16.0",
    "playwright": "^1.62.0",
    "typescript": "7.0.2"
  },
  "license": "GPL-3.0-only"
}
