+/* Anchor the system candidate list to the exact shaped caret rectangle
+ * published by the runtime. IMM32 consumes physical child-client pixels;
+ * the shared geometry is logical view-local, so this is the one DPI
+ * conversion at the platform boundary. */
+static bool gpuSurfaceApplyImeCandidateWindow(NativeView &view, HWND hwnd) {
+    if (!hwnd || !view.gpu_has_text_input_caret || view.gpu_text_input_id == 0) return false;
+    const double scale = gpuSurfaceScale(hwnd);
+    const LONG left = (LONG)lround(view.gpu_text_input_caret_x * scale);
+    const LONG top = (LONG)lround(view.gpu_text_input_caret_y * scale);
+    const LONG right = std::max(left + 1, (LONG)lround((view.gpu_text_input_caret_x + view.gpu_text_input_caret_width) * scale));
+    const LONG bottom = std::max(top + 1, (LONG)lround((view.gpu_text_input_caret_y + view.gpu_text_input_caret_height) * scale));
+    HIMC imc = ImmGetContext(hwnd);
+    if (!imc) return false;
+    CANDIDATEFORM candidate = {};
+    candidate.dwIndex = 0;
+    candidate.dwStyle = CFS_EXCLUDE;
+    candidate.ptCurrentPos = {left, bottom};
+    candidate.rcArea = {left, top, right, bottom};
+    const bool applied = ImmSetCandidateWindow(imc, &candidate) != FALSE;
+    CANDIDATEFORM observed = {};
+    observed.dwIndex = 0;
+    const bool queried = ImmGetCandidateWindow(imc, 0, &observed) != FALSE;
+    const DWORD candidate_bytes = ImmGetCandidateListW(imc, 0, nullptr, 0);
+    DWORD candidate_count = 0;
+    if (candidate_bytes >= sizeof(CANDIDATELIST)) {
+        std::vector<BYTE> candidate_storage(candidate_bytes);
+        auto *candidate_list = reinterpret_cast<CANDIDATELIST *>(candidate_storage.data());
+        const DWORD received = ImmGetCandidateListW(imc, 0, candidate_list, candidate_bytes);
+        if (received >= sizeof(CANDIDATELIST) && candidate_list->dwSize <= received) {
+            candidate_count = candidate_list->dwCount;
+        }
+    }
+    POINT screen_top_left = {left, top};
+    POINT screen_bottom_right = {right, bottom};
+    const bool screen_transformed =
+        ClientToScreen(hwnd, &screen_top_left) != FALSE &&
+        ClientToScreen(hwnd, &screen_bottom_right) != FALSE;
+    const char *evidence = getenv("NATIVE_SDK_IME_EVIDENCE");
+    if (evidence && strcmp(evidence, "1") == 0) {
+        fprintf(
+            stderr,
+            "native-ime-evidence platform=windows api=ImmSetCandidateWindow focused_id=%llu applied=%d queried=%d candidate_count=%lu candidate_bytes=%lu screen_transformed=%d logical_x=%.3f logical_y=%.3f logical_width=%.3f logical_height=%.3f physical_left=%ld physical_top=%ld physical_right=%ld physical_bottom=%ld screen_left=%ld screen_top=%ld screen_right=%ld screen_bottom=%ld observed_style=%lu observed_left=%ld observed_top=%ld observed_right=%ld observed_bottom=%ld\n",
+            (unsigned long long)view.gpu_text_input_id,
+            applied ? 1 : 0,
+            queried ? 1 : 0,
+            (unsigned long)candidate_count,
+            (unsigned long)candidate_bytes,
+            screen_transformed ? 1 : 0,
+            view.gpu_text_input_caret_x,
+            view.gpu_text_input_caret_y,
+            view.gpu_text_input_caret_width,
+            view.gpu_text_input_caret_height,
+            left,
+            top,
+            right,
+            bottom,
+            screen_top_left.x,
+            screen_top_left.y,
+            screen_bottom_right.x,
+            screen_bottom_right.y,
+            (unsigned long)observed.dwStyle,
+            observed.rcArea.left,
+            observed.rcArea.top,
+            observed.rcArea.right,
+            observed.rcArea.bottom
+        );
+        fflush(stderr);
+    }
+    ImmReleaseContext(hwnd, imc);
+    return applied;
