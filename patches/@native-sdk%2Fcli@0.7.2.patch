+int native_sdk_gtk_note_gpu_surface_input(native_sdk_gtk_host_t *host, uint64_t window_id, const char *label, size_t label_len) {
+    native_sdk_gtk_window_t *win = native_sdk_find_window(host, window_id);
+    char *label_copy = label_len > 0 ? native_sdk_strndup(label, label_len) : NULL;
+    native_sdk_gtk_native_view_t *view = native_sdk_find_native_view(win, label_copy);
+    free(label_copy);
+    if (!view || view->kind != NATIVE_SDK_GTK_VIEW_GPU_SURFACE || !view->widget) return 0;
+
+    /* Input supersedes a parked grid-paced emission. Queue exactly one
+     * prompt frame after the current input dispatch at GLib's high priority,
+     * before ordinary input, effect, layout, and paint sources can park it
+     * behind another main-loop turn. The responding present returns to the
+     * regular DEFAULT_IDLE scheduler, so this source cannot become a
+     * high-priority frame loop or starve paint. */
+    if (view->gpu_emit_source) {
+        g_source_remove(view->gpu_emit_source);
+        view->gpu_emit_source = 0;
+    }
+    view->gpu_emit_source = g_idle_add_full(
+        G_PRIORITY_HIGH,
+        native_sdk_gpu_surface_emit_scheduled,
+        view,
+        NULL
+    );
+    return view->gpu_emit_source != 0;
+}
