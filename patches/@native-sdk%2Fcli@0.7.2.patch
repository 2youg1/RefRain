+int native_sdk_windows_update_text_input_geometry(Host *host, uint64_t window_id, const char *label, size_t label_len, uint64_t focused_id, int has_caret, double x, double y, double width, double height) {
+    if (!host || label_len == 0) return 0;
+    auto found = host->native_views.find(nativeViewKey(window_id, slice(label, label_len)));
+    if (found == host->native_views.end() || found->second.kind != kViewGpuSurface || !found->second.hwnd) return 0;
+    NativeView &view = found->second;
+    if (!has_caret) {
+        view.gpu_text_input_id = 0;
+        view.gpu_has_text_input_caret = false;
+        view.gpu_text_input_caret_x = 0;
+        view.gpu_text_input_caret_y = 0;
+        view.gpu_text_input_caret_width = 0;
+        view.gpu_text_input_caret_height = 0;
+        return 1;
+    }
+    if (focused_id == 0 || !std::isfinite(x) || !std::isfinite(y) ||
+        !std::isfinite(width) || !std::isfinite(height) || width <= 0 || height <= 0) return 0;
+    view.gpu_text_input_id = focused_id;
+    view.gpu_has_text_input_caret = true;
+    view.gpu_text_input_caret_x = x;
+    view.gpu_text_input_caret_y = y;
+    view.gpu_text_input_caret_width = width;
+    view.gpu_text_input_caret_height = height;
+    (void)gpuSurfaceApplyImeCandidateWindow(view, view.hwnd);
+    return 1;
+}
