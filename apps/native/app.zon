.{
    .id = "app.refrain.desktop",
    .name = "refrain",
    .display_name = "RefRain",
    .description = "A local-first writing workbench.",
    .version = "0.3.0",
    .icons = .{"assets/icon.png"},
    .platforms = .{ "macos", "windows", "linux" },
    .permissions = .{ "view", "command" },
    .capabilities = .{ "native_views", "gpu_surfaces" },
    // 快捷键：id 是 `commandMsg` 收到的那个名字，`primary` 在 macOS 是 ⌘、
    // 在 Windows/Linux 是 Ctrl，所以一处声明三平台都对。
    // 八个去处直达 + 面板开合 + 名录上下 + 保存撤销，与 `workbench.ts` 的
    // 下标次序同源；新增一个去处要同时加一行这里和一行去处表。
    .shortcuts = .{
        .{ .id = "go.1", .key = "1", .modifiers = .{"primary"} },
        .{ .id = "go.2", .key = "2", .modifiers = .{"primary"} },
        .{ .id = "go.3", .key = "3", .modifiers = .{"primary"} },
        .{ .id = "go.4", .key = "4", .modifiers = .{"primary"} },
        .{ .id = "go.5", .key = "5", .modifiers = .{"primary"} },
        .{ .id = "go.6", .key = "6", .modifiers = .{"primary"} },
        .{ .id = "go.7", .key = "7", .modifiers = .{"primary"} },
        .{ .id = "go.8", .key = "8", .modifiers = .{"primary"} },
        .{ .id = "palette", .key = "k", .modifiers = .{"primary"} },
        .{ .id = "roster.next", .key = "j", .modifiers = .{"primary"} },
        .{ .id = "roster.previous", .key = "k", .modifiers = .{ "primary", "shift" } },
        .{ .id = "document.save", .key = "s", .modifiers = .{"primary"} },
        .{ .id = "document.undo", .key = "z", .modifiers = .{"primary"} },
        // 搜索框住在文件树的顶部（同一个去处）：直达即去文件树，
        // 不新开一个去处。
        .{ .id = "search", .key = "f", .modifiers = .{"primary"} },
        // 面板退层：Escape 与 Ctrl+[ 同义（旧版 shortcuts 同一条：不想
        // 离开主键区的手用方括号）。Escape 无修饰符，三平台同一个键。
        .{ .id = "panel.back", .key = "escape" },
        .{ .id = "panel.back.bracket", .key = "[", .modifiers = .{"primary"} },
        .{ .id = "theme.next", .key = "t", .modifiers = .{ "primary", "shift" } },
        // KARA 专注写作的手动开关：Ctrl+Enter（与设置页按钮同一条消息）。
        .{ .id = "kara.toggle", .key = "enter", .modifiers = .{"primary"} },
        // 退出：三平台的惯例键位（macOS ⌘Q、Windows/Linux Ctrl+Q）。
        // 它同时是录制会话唯一的干净出口——`quitApp` 封口 journal，
        // 被信号杀掉的进程留不下结束标记。
        .{ .id = "app.quit", .key = "q", .modifiers = .{"primary"} },
    },
    // 系统菜单栏：与快捷键共用同一个 command id 空间，所以这一段不新增任何
    // 分派代码——`commandMsg` 已经认识每一个 id。菜单里写出键位，作者因此
    // 能从菜单学会快捷键，而不必去翻文档。
    // 一个成熟的桌面应用必须有菜单栏：它是「这个软件能做什么」的完整清单，
    // 也是 macOS 上唯一可被系统搜索到的入口。
    .menus = .{
        .{
            .title = "文件",
            .items = .{
                .{ .label = "保存", .command = "document.save", .key = "s", .modifiers = .{"primary"} },
                .{ .separator = true },
                .{ .label = "文件树", .command = "go.2", .key = "2", .modifiers = .{"primary"} },
                .{ .separator = true },
                .{ .label = "退出", .command = "app.quit", .key = "q", .modifiers = .{"primary"} },
            },
        },
        .{
            .title = "编辑",
            .items = .{
                .{ .label = "查找", .command = "search", .key = "f", .modifiers = .{"primary"} },
                .{ .separator = true },
                .{ .label = "撤销", .command = "document.undo", .key = "z", .modifiers = .{"primary"} },
            },
        },
        .{
            .title = "前往",
            .items = .{
                // 键位语义与 v0.2.4 的四区同源（settings/files/editing/agent，
                // quarters.ts）：1 设置、2 文件、3 稿子、4 Agent（记住上次的
                // Agent 层去处）、5..7 直达信箱/连接/历史。菜单与键位同路——
                // 作者从菜单学会键位，所以标签必须说键真正去的地方。
                .{ .label = "设置", .command = "go.1", .key = "1", .modifiers = .{"primary"} },
                .{ .label = "文件", .command = "go.2", .key = "2", .modifiers = .{"primary"} },
                .{ .label = "稿子", .command = "go.3", .key = "3", .modifiers = .{"primary"} },
                .{ .label = "Agent", .command = "go.4", .key = "4", .modifiers = .{"primary"} },
                .{ .label = "信箱", .command = "go.5", .key = "5", .modifiers = .{"primary"} },
                .{ .label = "连接", .command = "go.6", .key = "6", .modifiers = .{"primary"} },
                .{ .label = "历史", .command = "go.7", .key = "7", .modifiers = .{"primary"} },
                .{ .separator = true },
                .{ .label = "命令面板", .command = "palette", .key = "k", .modifiers = .{"primary"} },
                // KARA 专注写作：Ctrl+Enter 开合（与设置页的开关同一条消息）。
                .{ .label = "专注写作", .command = "kara.toggle", .key = "enter", .modifiers = .{"primary"} },
            },
        },
        .{
            .title = "外观",
            .items = .{
                .{ .label = "换主题", .command = "theme.next", .key = "t", .modifiers = .{ "primary", "shift" } },
            },
        },
    },
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "RefRain",
                .width = 1280,
                .height = 800,
                .min_width = 920,
                .min_height = 600,
                .restore_state = true,
                .restore_policy = "center_on_primary",
                .views = .{
                    .{ .label = "document", .kind = "gpu_surface", .fill = true, .role = "Writing workbench", .accessibility_label = "RefRain document", .gpu_backend = "metal", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "opaque", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{},
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
}
