<column gap="8">
  <row gap="10" cross="center">
    <text grow="1">RefRain · Native document surface</text>
    <if test="{hostReady}">
      <badge variant="primary">Rust authority ready</badge>
    </if>
    <else>
      <badge variant="secondary">Host check</badge>
    </else>
    <button variant="secondary" on-press="document_undo">Undo</button>
  </row>
  <text>{status}</text>
  <text>protocol {protocolVersion} · revision {documentRevision} · {documentBlocks} blocks · {documentBytes} bytes</text>
</column>
