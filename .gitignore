node_modules/
dist/
.DS_Store
*.log

# Local design authority. `verify:no-spec-upload` enforces this boundary.
/SPEC.md

# Rust and native generated output.
target/
apps/native/.native/
apps/native/.zig-cache/
apps/native/zig-out/

# TypeScript incremental build state.
*.tsbuildinfo

# IME 实测的证据输出：脚本进仓库，结果不进。
e2e/ime/results/

# 测试语料是 scripts/freeze-corpora.ts 的产物，构建与门禁前自动生成。
# 权威是那个脚本，不是磁盘上的字节（KL9 2026-07-30：上传不该包含这些）。
/tests/corpora/*.md

# TMPDIR for the recycle-bin tests: the trash service cannot write to
# /.Trash-1000 when /tmp is a separate mount, so the documented command points
# TMPDIR here. Scratch directories, never source.
/.tmp/
.worktrees/

# Local walkthrough/probe artifacts — evidence for the author, never shipped
# (same reason SPEC.md is ignored: the most private files are the ones open
# while debugging).
probe-results/
apps/native/e2e-run/
